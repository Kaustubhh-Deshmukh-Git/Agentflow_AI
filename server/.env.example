# Server Environment Configuration (.env)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Cloud Database URI
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agentflow?retryWrites=true&w=majority
MONGODB_URI=

# Cloud Redis (e.g. Upstash, Redis Cloud)
# Format: rediss://default:<password>@<endpoint>:6379
REDIS_URL=

# Security
JWT_SECRET=super_secret_jwt_token_key_change_me_in_production
# 64-char hex key for AES-256-GCM token encryption
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# AI Keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
