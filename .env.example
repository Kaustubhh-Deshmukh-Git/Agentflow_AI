# ==========================================
# Agentflow_AI Environment Configuration
# ==========================================

# ------------------------------------------
# Server Configuration (server/.env)
# ------------------------------------------
PORT=5000
NODE_ENV=production

# 1. MongoDB Cloud Database (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/agentflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@cluster0.mongodb.net/agentflow?retryWrites=true&w=majority

# 2. Redis Cloud (Upstash or Redis Cloud for BullMQ queues)
# Example: rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379
REDIS_URL=

# 3. Security & Authentication
JWT_SECRET=generate_a_random_secure_jwt_secret_string_here_32_chars
# 32-byte hex string (64 characters) for AES-256-GCM token encryption
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. Frontend Client URL (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,https://agentflow.vercel.app

# 5. AI Reasoning Providers (At least one recommended)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# 6. Third-Party Integrations (Optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# ------------------------------------------
# Frontend Configuration (client/.env.local)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
